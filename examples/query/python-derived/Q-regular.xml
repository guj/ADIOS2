<?xml version="1.0"?>
<adios-query>
  <io name="query">

  <tag name="qx">
    <var name="/data/particles/electrons/position/x/__data__">
      <op value="AND">
	<range  compare="GT" value="-0.05e-06"/>
        <range  compare="LT" value="0.05e-06"/>
      </op>
    </var>
  </tag>


  <tag name="qy">
    <var name="/data/particles/electrons/position/y/__data__">
      <op value="AND">
        <range  compare="GT" value="-0.05e-06"/>
        <range  compare="LT" value="0.05e-06"/>
      </op>
    </var>
  </tag>

  <query op="AND">
      <qx/>
      <qy/>
  </query>
    
  </io>
</adios-query>
